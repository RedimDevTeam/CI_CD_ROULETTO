
pipeline {
    agent any

    environment {
        APP_NAME   = "rouletto"
        DEPLOY_DIR = "/opt/rouletto"
        JAR_NAME   = "rouletto-0.0.1-SNAPSHOT.jar"
    }

    stages {
        stage('Check Environment') {
            steps {
                echo "===== Checking Environment Tools ====="
                sh '''
                    java -version
                    mvn -version
                    git --version
                '''
            }
        }

        stage('Checkout') {
            steps {
                echo "===== Checking out Source Code ====="
                checkout scm
                sh 'git log -1 --oneline'
            }
        }

        stage('Build') {
            steps {
                
                echo "===== Building Main Application (${APP_NAME}) ====="
                dir("${env.APP_NAME}") { sh 'mvn clean install -DskipTests' }
            }
        }

        stage('Find JAR') {
            steps {
                echo "===== Locating Artifact ====="
                dir("${env.APP_NAME}") {
                    sh 'find target -maxdepth 1 -name "*.jar" -type f ! -name "*-sources.jar" -print'
                }
            }
        }

        stage('Deploy') {
            steps {
                echo "===== Deploying ${APP_NAME} ====="
                dir("${env.APP_NAME}") {
                    sh '''
                        # Find the executable JAR while excluding sources/javadoc JARs
                        JAR_FILE=$(find target -maxdepth 1 -name "*.jar" -type f ! -name "*-sources.jar" ! -name "*-javadoc.jar" | head -1)

                        if [ -z "$JAR_FILE" ]; then
                            echo "ERROR: JAR file not found in target dynamic path"
                            exit 1
                        fi

                        echo "Found target JAR: $JAR_FILE"
                        
                        # Ensure deployment directory exists and move artifact
                        sudo mkdir -p "${DEPLOY_DIR}"
                        sudo mv "$JAR_FILE" "${DEPLOY_DIR}/${JAR_NAME}"

                        echo "Artifact successfully deployed to ${DEPLOY_DIR}/${JAR_NAME}"
                    '''
                }
            }
        }

        stage('Restart Application') {
            steps {
                echo "===== Restarting Service: ${APP_NAME} ====="
                sh '''
                    sudo systemctl restart ${APP_NAME}
                    sleep 5
                    sudo systemctl status ${APP_NAME} --no-pager
                '''
            }
        }
    }

    post {
        success {
            echo "======================================"
            echo "CI/CD PIPELINE SUCCESSFUL: ${APP_NAME}"
            echo "======================================"
        }

        failure {
            echo "======================================"
            echo "CI/CD PIPELINE FAILED: ${APP_NAME}"
            echo "======================================"
        }

        always {
            echo "===== Cleaning Up Workspace ====="
            cleanWs deleteDirs: true, notFailBuild: true
        }
    }
}
